# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Три расширения Screen Time плагин react-native-device-activity копирует
# сюда из node_modules при каждом prebuild — хранить их незачем.
targets/*

# А живая активность написана руками, и это единственный её экземпляр.
!targets/liveactivity/
# Кроме прав доступа: их плагин выводит из expo-target.config.js.
targets/liveactivity/generated.entitlements
